+test("drift does not match a short citation inside a later line number", () => {
+  const source = Array.from({ length: 30 }, (_, i) => `line ${i + 1}`);
+  const root = repo({ "src/a.ts": source.join("\n") + "\n" });
+  seed(root);
+  page(root, "components/citations.md", {
+    sources: ["src/a.ts"],
+    body: "Older: `src/a.ts:20`.",
+  });
+  git(root, "add", "-A");
+  git(root, "commit", "-qm", "cite line 20");
+
+  const reshaped = source.slice();
+  reshaped.unshift("new 1", "new 2", "new 3", "new 4", "new 5");
+  reshaped.splice(19, 5); // Remove the five lines before old line 20, keeping that citation fixed.
+  put(root, "src/a.ts", reshaped.join("\n") + "\n");
+  git(root, "add", "-A");
+  git(root, "commit", "-qm", "reshape source without moving line 20");
+
+  page(root, "components/citations.md", {
+    sources: ["src/a.ts"],
+    body: "Older: `src/a.ts:20`.\n\nCurrent: `src/a.ts:2`.",
+  });
+  git(root, "add", "-A");
+  git(root, "commit", "-qm", "add current line 2 citation");
+
+  const drift = json<DriftJson>(root, "check", "drift", "--json");
+  assert.equal(drift.stale.find((page) => page.id === "components/citations"), undefined);
+});
